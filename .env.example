# ─────────────────────────────────────────────────────────────
# Variáveis NEXT_PUBLIC_* — expostas ao navegador (bundle do frontend).
# Só a URL e a anon key do Supabase entram aqui; a anon key é segura para
# o cliente porque toda a proteção real vem das políticas de RLS no banco.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Variáveis server-only — NUNCA prefixar com NEXT_PUBLIC_, nunca chegam
# ao bundle do cliente. Usadas só em Route Handlers / Server Actions /
# módulos marcados "server-only".
# ─────────────────────────────────────────────────────────────

# Supabase — service_role bypassa RLS; só é lida em src/lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

# Meta (Lead Ads / Graph API) — ainda NÃO conectado neste projeto.
# Preencher apenas quando for integrar de verdade (ver README).
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=

# WhatsApp Business Platform (Cloud API) — ainda NÃO conectado neste
# projeto. Preencher apenas quando for integrar de verdade (ver README).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=

# Segredo compartilhado entre o Supabase pg_cron (via pg_net) e a rota
# POST /api/automation/run — sem ele, o worker de automação não roda.
# O MESMO valor também precisa ser salvo em private.app_settings no banco
# (chave "automation_cron_secret") depois do deploy — ver README.
AUTOMATION_CRON_SECRET=

# Modo seguro para testar o worker de automação antes do WhatsApp estar
# conectado: reivindica e processa o job normalmente, mas nunca chama a
# WhatsApp Cloud API nem grava mensagem como enviada de verdade. Definir
# como "true" até o WhatsApp Business Platform ser conectado de fato.
AUTOMATION_DRY_RUN=true
